#!/usr/bin/env python3
"""Self-contained Qwen KV benchmark; --instructions prints its usage guide."""
import base64
import hashlib
import importlib
import io
import os
from pathlib import Path, PurePosixPath
import stat
import sys
import tempfile
import zipfile

_PAYLOAD_SHA256 = @@PAYLOAD_SHA256@@
_MEMBER_COUNT = @@MEMBER_COUNT@@
_MAX_UNPACKED = 32 * 1024 * 1024
_PAYLOAD_B64 = @@PAYLOAD_B64@@

def _payload():
    try:
        data = base64.b64decode(_PAYLOAD_B64, validate=True)
    except Exception as exc:
        raise ValueError('Embedded source payload is invalid') from exc
    if hashlib.sha256(data).hexdigest() != _PAYLOAD_SHA256:
        raise ValueError('Embedded source payload SHA256 mismatch')
    return data

def _members(archive):
    entries = archive.infolist()
    if len(entries) != _MEMBER_COUNT or sum(x.file_size for x in entries) > _MAX_UNPACKED:
        raise ValueError('Embedded source archive has invalid size/member count')
    seen = set()
    for entry in entries:
        name = entry.filename
        relative = PurePosixPath(name)
        mode = (entry.external_attr >> 16) & 0xffff
        if (not name or relative.is_absolute() or '\\' in name or ':' in name or
                any(part in ('', '.', '..') for part in name.split('/')) or
                entry.is_dir() or stat.S_ISLNK(mode) or name in seen):
            raise ValueError('Unsafe embedded source archive member: ' + repr(name))
        seen.add(name)
    return entries

def _extract(destination):
    destination = Path(destination)
    if destination.is_symlink():
        raise ValueError('Source destination must not be a symlink')
    if destination.exists() and (not destination.is_dir() or any(destination.iterdir())):
        raise ValueError('Source destination must be absent or an empty directory')
    with zipfile.ZipFile(io.BytesIO(_payload())) as archive:
        entries = _members(archive)
        destination.mkdir(parents=True, exist_ok=True, mode=0o700)
        root = destination.resolve()
        for entry in entries:
            target = root.joinpath(*PurePosixPath(entry.filename).parts)
            if not target.resolve().is_relative_to(root):
                raise ValueError('Embedded source path escapes destination')
            target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            with target.open('xb') as stream:
                stream.write(archive.read(entry))
    return destination.resolve()

def main():
    args = sys.argv[1:]
    try:
        if args and args[0] == '--instructions':
            if len(args) != 1:
                raise ValueError('--instructions takes no other arguments')
            with zipfile.ZipFile(io.BytesIO(_payload())) as archive:
                _members(archive)
                print(archive.read('qwen_kv_bench/README.md').decode('utf-8'))
            return 0
        if args and args[0] == '--extract-source':
            if len(args) != 2:
                raise ValueError('Usage: --extract-source DIR (directory must be empty)')
            target = _extract(args[1])
            print(str(target))
            print('Source payload SHA256: ' + _PAYLOAD_SHA256)
            return 0
        with tempfile.TemporaryDirectory(prefix='qwen-kv-source-') as private:
            source = _extract(Path(private) / _PAYLOAD_SHA256)
            sys.path.insert(0, str(source))
            os.environ['QWEN_KV_SOURCE_SHA256'] = _PAYLOAD_SHA256
            os.environ['QWEN_KV_SOURCE_DIR'] = str(source)
            try:
                runner = importlib.import_module('qwen_kv_bench.runner')
                return runner.main()
            except ModuleNotFoundError as exc:
                if exc.name in ('torch', 'numpy', 'transformers', 'safetensors', 'tokenizers'):
                    print('Missing benchmark dependency: ' + str(exc.name) +
                        '. Run this script with --instructions for installation steps.', file=sys.stderr)
                    return 2
                raise
    except (ValueError, OSError, zipfile.BadZipFile) as exc:
        print('Qwen KV benchmark launcher: ' + str(exc), file=sys.stderr)
        return 2

if __name__ == '__main__':
    raise SystemExit(main())
